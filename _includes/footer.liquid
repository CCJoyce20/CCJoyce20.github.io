{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0"></div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    <div class="container"></div>
  </footer>
{% endif %}

<style>
  /* Section headings (publication years, project categories): the theme renders
     these in the faint divider grey, which is hard to read. Use real text color. */
  .publications h2.bibliography,
  .projects h2.category {
    color: var(--global-text-color);
    font-weight: 600;
    opacity: 1;
  }

  /* Page section headings: make them stand out from body text. */
  .post h2,
  .post h3,
  .post h4 {
    font-weight: 700;
    color: var(--global-text-color);
  }

  /* Project card titles: larger, bolder, higher contrast */
  .projects .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.5rem;
    color: var(--global-text-color);
  }
  .projects .card-text {
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--global-text-color-light);
  }
</style>

<script>
  // Two-state theme toggle: alternate light <-> dark only (skip "system").
  if (typeof toggleThemeSetting !== "undefined") {
    toggleThemeSetting = () => {
      setThemeSetting(determineComputedTheme() === "dark" ? "light" : "dark");
    };
  }
</script>
